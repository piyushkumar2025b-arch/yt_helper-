{
  "entities": {
    "UserList": {
      "title": "UserList",
      "description": "A user-created custom collection or list for saving video summaries, books, articles, and notes.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The Firebase Auth UID of the list owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-friendly name of the list.",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Optional description of what this list is for.",
          "minLength": 0,
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "description": "Category tag for organizing lists.",
          "enum": ["general", "videos", "reading", "study", "favorites"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the list was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the list was last updated."
        }
      },
      "required": ["ownerId", "name", "description", "category", "createdAt", "updatedAt"]
    },
    "ListItem": {
      "title": "ListItem",
      "description": "An individual saved video summary, book, research paper, article, or note inside a UserList subcollection.",
      "type": "object",
      "properties": {
        "listId": {
          "type": "string",
          "description": "ID of the parent UserList document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "The Firebase Auth UID of the item owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "description": "Type of saved item.",
          "enum": ["video", "summary", "book", "article", "note"],
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "description": "Title of the saved video, book, article, or note.",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "description": "Source URL for the saved item.",
          "minLength": 0,
          "maxLength": 1000
        },
        "subtitle": {
          "type": "string",
          "description": "Author, channel, or source subtitle.",
          "minLength": 0,
          "maxLength": 300
        },
        "content": {
          "type": "string",
          "description": "Saved markdown summary, quote, or excerpt.",
          "minLength": 0,
          "maxLength": 50000
        },
        "notes": {
          "type": "string",
          "description": "Personal user notes on this saved item.",
          "minLength": 0,
          "maxLength": 5000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the item was added."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the item was last updated."
        }
      },
      "required": ["listId", "ownerId", "itemType", "title", "url", "subtitle", "content", "notes", "createdAt", "updatedAt"]
    },
    "SavedSummary": {
      "title": "SavedSummary",
      "description": "A synthesized video summary document persisted in Firebase Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The Firebase Auth UID of the summary owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "videoId": {
          "type": "string",
          "description": "YouTube video ID or document identifier.",
          "minLength": 0,
          "maxLength": 64
        },
        "videoUrl": {
          "type": "string",
          "description": "Source video URL.",
          "minLength": 0,
          "maxLength": 1000
        },
        "videoTitle": {
          "type": "string",
          "description": "Title of the summarized video.",
          "minLength": 1,
          "maxLength": 300
        },
        "authorName": {
          "type": "string",
          "description": "Channel or speaker name.",
          "minLength": 0,
          "maxLength": 200
        },
        "summaryType": {
          "type": "string",
          "description": "Summary preset style.",
          "minLength": 1,
          "maxLength": 64
        },
        "markdown": {
          "type": "string",
          "description": "Full synthesized markdown summary with citations and notes.",
          "minLength": 1,
          "maxLength": 50000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the summary was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the summary was last updated."
        }
      },
      "required": ["ownerId", "videoId", "videoUrl", "videoTitle", "authorName", "summaryType", "markdown", "createdAt", "updatedAt"]
    },
    "CustomResource": {
      "title": "CustomResource",
      "description": "A user-added exact video resource, book, research paper, dataset, or direct citation persisted in Firebase Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The Firebase Auth UID of the resource owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "videoId": {
          "type": "string",
          "description": "Optional associated YouTube video ID.",
          "minLength": 0,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Title of the exact resource, book, or paper.",
          "minLength": 1,
          "maxLength": 300
        },
        "resourceType": {
          "type": "string",
          "description": "Classification of the exact resource.",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "Explanation of how this resource relates to the video.",
          "minLength": 0,
          "maxLength": 2000
        },
        "primaryUrl": {
          "type": "string",
          "description": "Direct verification or reference URL.",
          "minLength": 1,
          "maxLength": 1000
        },
        "authorOrCreator": {
          "type": "string",
          "description": "Author, researcher, or organization.",
          "minLength": 0,
          "maxLength": 200
        },
        "formattedTime": {
          "type": "string",
          "description": "Optional MM:SS video timestamp.",
          "minLength": 0,
          "maxLength": 32
        },
        "exactQuote": {
          "type": "string",
          "description": "Optional verbatim quote from the transcript.",
          "minLength": 0,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the resource was added."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the resource was last updated."
        }
      },
      "required": ["ownerId", "videoId", "title", "resourceType", "description", "primaryUrl", "authorOrCreator", "formattedTime", "exactQuote", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/lists/{listId}": {
      "schema": "UserList",
      "description": "Top-level collection storing custom user lists."
    },
    "/lists/{listId}/items/{itemId}": {
      "schema": "ListItem",
      "description": "Subcollection storing saved items belonging to a specific UserList."
    },
    "/summaries/{summaryId}": {
      "schema": "SavedSummary",
      "description": "Top-level collection storing user-saved and synced video summaries."
    },
    "/resources/{resourceId}": {
      "schema": "CustomResource",
      "description": "Top-level collection storing user-added exact video resources and primary citations."
    }
  }
}
