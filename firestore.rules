rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 3. Validation Blueprints
    function isValidUserList(data) {
      return data.keys().hasAll(['ownerId', 'name', 'description', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'description', 'category', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.category is string && data.category.size() <= 32 && data.category in ['general', 'videos', 'reading', 'study', 'favorites']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidListItem(data, parentListId) {
      return data.keys().hasAll(['listId', 'ownerId', 'itemType', 'title', 'url', 'subtitle', 'content', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['listId', 'ownerId', 'itemType', 'title', 'url', 'subtitle', 'content', 'notes', 'createdAt', 'updatedAt'])
        && data.listId is string && data.listId.size() >= 1 && data.listId.size() <= 128 && data.listId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.listId == parentListId
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.itemType is string && data.itemType.size() <= 32 && data.itemType in ['video', 'summary', 'book', 'article', 'note']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.url is string && data.url.size() <= 1000
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.content is string && data.content.size() <= 50000
        && data.notes is string && data.notes.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedSummary(data) {
      return data.keys().hasAll(['ownerId', 'videoId', 'videoUrl', 'videoTitle', 'authorName', 'summaryType', 'markdown', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'videoId', 'videoUrl', 'videoTitle', 'authorName', 'summaryType', 'markdown', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.videoId is string && data.videoId.size() <= 64
        && data.videoUrl is string && data.videoUrl.size() <= 1000
        && data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 300
        && data.authorName is string && data.authorName.size() <= 200
        && data.summaryType is string && data.summaryType.size() >= 1 && data.summaryType.size() <= 64
        && data.markdown is string && data.markdown.size() >= 1 && data.markdown.size() <= 50000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomResource(data) {
      return data.keys().hasAll(['ownerId', 'videoId', 'title', 'resourceType', 'description', 'primaryUrl', 'authorOrCreator', 'formattedTime', 'exactQuote', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'videoId', 'title', 'resourceType', 'description', 'primaryUrl', 'authorOrCreator', 'formattedTime', 'exactQuote', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.videoId is string && data.videoId.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.resourceType is string && data.resourceType.size() >= 1 && data.resourceType.size() <= 64
        && data.description is string && data.description.size() <= 2000
        && data.primaryUrl is string && data.primaryUrl.size() >= 1 && data.primaryUrl.size() <= 1000
        && data.authorOrCreator is string && data.authorOrCreator.size() <= 200
        && data.formattedTime is string && data.formattedTime.size() <= 32
        && data.exactQuote is string && data.exactQuote.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityHistory(data) {
      return data.keys().hasAll(['ownerId', 'actionType', 'queryOrTitle', 'detail', 'url', 'videoId', 'dateKey', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'actionType', 'queryOrTitle', 'detail', 'url', 'videoId', 'dateKey', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.actionType is string && data.actionType.size() <= 32 && data.actionType in ['video', 'summary', 'word_lookup', 'research_search', 'transcript_search', 'ai_question', 'artifact_saved', 'audio_narration']
        && data.queryOrTitle is string && data.queryOrTitle.size() >= 1 && data.queryOrTitle.size() <= 300
        && data.detail is string && data.detail.size() <= 2000
        && data.url is string && data.url.size() <= 1000
        && data.videoId is string && data.videoId.size() <= 64
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isParentListOwner(listId) {
      return exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid;
    }

    // 4. Collection: /lists/{listId}
    match /lists/{listId} {
      allow get: if isSignedIn() && isValidId(listId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(listId)
        && isValidUserList(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(listId)
        && isValidUserList(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(listId)
        && existing().ownerId == request.auth.uid;

      // 5. Subcollection: /lists/{listId}/items/{itemId}
      match /items/{itemId} {
        allow get: if isSignedIn()
          && isValidId(listId)
          && isValidId(itemId)
          && existing().ownerId == request.auth.uid
          && isParentListOwner(listId);

        allow list: if isSignedIn()
          && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(listId)
          && isValidId(itemId)
          && isValidListItem(incoming(), listId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentListOwner(listId);

        allow update: if isVerifiedUser()
          && isValidId(listId)
          && isValidId(itemId)
          && isValidListItem(incoming(), listId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().listId == existing().listId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'subtitle', 'content', 'notes', 'itemType', 'updatedAt'])
          )
          && isParentListOwner(listId);

        allow delete: if isVerifiedUser()
          && isValidId(listId)
          && isValidId(itemId)
          && existing().ownerId == request.auth.uid
          && isParentListOwner(listId);
      }
    }

    // 6. Collection: /summaries/{summaryId}
    match /summaries/{summaryId} {
      allow get: if isSignedIn() && isValidId(summaryId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(summaryId)
        && isValidSavedSummary(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(summaryId)
        && isValidSavedSummary(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['videoId', 'videoUrl', 'videoTitle', 'authorName', 'summaryType', 'markdown', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(summaryId)
        && existing().ownerId == request.auth.uid;
    }

    // 7. Collection: /resources/{resourceId}
    match /resources/{resourceId} {
      allow get: if isSignedIn() && isValidId(resourceId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(resourceId)
        && isValidCustomResource(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(resourceId)
        && isValidCustomResource(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['videoId', 'title', 'resourceType', 'description', 'primaryUrl', 'authorOrCreator', 'formattedTime', 'exactQuote', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(resourceId)
        && existing().ownerId == request.auth.uid;
    }

    // 8. Collection: /history/{historyId}
    match /history/{historyId} {
      allow get: if isSignedIn() && isValidId(historyId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(historyId)
        && isValidActivityHistory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(historyId)
        && isValidActivityHistory(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().dateKey == existing().dateKey
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['actionType', 'queryOrTitle', 'detail', 'url', 'videoId', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(historyId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
